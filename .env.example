# Server-only secrets. Copy to .env, chmod 600, and replace every empty secret.
APP_ENV=development
APP_NAME=Cabinet Survey AI
DATABASE_URL=postgresql+psycopg://cabinet:CHANGE_ME@localhost:5432/cabinet_survey
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
SECRET_ENCRYPTION_KEY=
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Speech-to-text is optional and provider-independent. Leave disabled to run
# voice intake through the typed-text path only; the API then answers audio
# uploads with 503 and a clear message instead of guessing.
STT_PROVIDER=disabled            # disabled | openai_compatible
STT_BASE_URL=                    # must be HTTPS, e.g. https://stt.your-provider.example/v1
STT_API_KEY=
STT_MODEL=whisper-1
AUDIO_MAX_BYTES=10485760

# Three DIFFERENT credentials: bot token, Telegram ingress, API/worker shared secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WORKER_SECRET=
# Public HTTPS address, registered with Telegram setWebhook (no token in this URL).
TELEGRAM_WEBHOOK_URL=https://api.your-domain.example/telegram/webhook

# Compose overrides these to service-network/storage-container values.
BACKEND_URL=http://api:8000/api/v1/
EXPORT_STORAGE_DIR=/data/exports
ASSET_STORAGE_DIR=/data/assets
WORKER_DATABASE=/data/worker/worker.sqlite
